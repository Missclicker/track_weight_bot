# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather (step 1 in README).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Group chat id(s) the bot serves, comma-separated. Group ids are negative (-100...).
# Messages from any other chat are ignored.
ALLOWED_CHAT_IDS=-1001234567890

# --- Google Sheets ----------------------------------------------------------
# The part of the spreadsheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcdef
# Service-account key: EITHER a path to the JSON file ...
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# ... OR the whole JSON on one line (takes precedence when set). Useful for hosted secrets.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Gemini -----------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyExampleKeyFromAiStudio
# Models: any current Flash model works. If a name is retired, pick one from
# https://ai.google.dev/gemini-api/docs/models (e.g. a newer gemini-x.y-flash).
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite

# --- Behaviour --------------------------------------------------------------
# IANA timezone used for scheduling and as fallback for users without `tz` in the sheet.
DEFAULT_TZ=Europe/Kyiv
# Time (HH:MM, in each user's tz) after which people without a weigh-in are pinged.
WEIGH_IN_DEADLINE=11:00
# Weekly AI report: day (mon..sun) and time (HH:MM in DEFAULT_TZ).
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_TIME=20:00
# A bare number inside this range is treated as a body weight in kg.
WEIGHT_MIN=40
WEIGHT_MAX=200
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Used by docker-compose for the container clock (optional).
TZ=Europe/Kyiv
